# Copy this file to .env and fill in your own key.
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# NEVER commit a real key. .env is listed in .gitignore.

OPENAI_API_KEY=sk-your-key-here

# ---- optional overrides (defaults shown) ---------------------------------
# EMBEDDING_PROVIDER=openai            # openai | local (bge-small, no key needed)
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini

# RELEVANCE_THRESHOLD=4.0              # reranker score below this -> refuse (gate 1)
# ENABLE_GROUNDEDNESS_CHECK=true       # gate 4; costs ~15% of per-query spend

# BM25_K=10                            # lexical candidates  (production: ~50)
# DENSE_K=10                           # dense candidates    (production: ~50)
# RERANK_TOP_N=4                       # blocks shown to the answering model

# LOG_LEVEL=INFO                       # console verbosity; the log file always gets DEBUG
# LOG_DIR=logs
